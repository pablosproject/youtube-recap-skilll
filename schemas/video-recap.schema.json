{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/youtube-video-recap.schema.json",
  "title": "YouTube Video Recap Data",
  "description": "Deterministic intermediate data extracted from a YouTube transcript and used to render an interactive recap artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "video",
    "abstract",
    "mainTakeaway",
    "highlights",
    "sections",
    "conclusion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "channel": { "type": "string" },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seconds", "formatted"],
          "properties": {
            "seconds": { "type": "integer", "minimum": 0 },
            "formatted": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}:\\d{2}$" }
          }
        }
      }
    },
    "abstract": {
      "type": "string",
      "description": "Concise 1–2 sentence summary of the video and why it matters.",
      "minLength": 1
    },
    "mainTakeaway": {
      "type": "string",
      "description": "The single strongest idea, argument, or conclusion from the video.",
      "minLength": 1
    },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/timestampedPoint" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "points"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/timestampedPoint" }
          }
        }
      }
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "footerText": {
      "type": "string"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transcriptFile": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "timestampedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "seconds", "title", "description"],
      "properties": {
        "time": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" },
        "seconds": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "emphasis": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional phrases that may be emphasized in the rendered HTML."
        }
      }
    }
  }
}
